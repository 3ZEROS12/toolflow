{
  "name": "toolflow",
  "version": "3.3.4",
  "description": "Save 80%+ context tokens in Pi — automatically compresses huge bash/grep logs, caches duplicate file reads, prunes unused tools, and blocks accidental .env/git deletions.",
  "type": "module",
  "main": "src/index.ts",
  "files": [
    "src",
    "assets",
    "README.md",
    "README_ja.md",
    "README_zh.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/3ZEROS12/toolflow/main/assets/hero-en.svg"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/3ZEROS12/toolflow.git"
  },
  "homepage": "https://github.com/3ZEROS12/toolflow#readme",
  "bugs": {
    "url": "https://github.com/3ZEROS12/toolflow/issues"
  },
  "scripts": {
    "test": "npx tsx tests/test_suite.ts"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "toolflow",
    "token-saver",
    "compression",
    "context-compression",
    "dehydration",
    "sandbox",
    "security",
    "guardrails",
    "workflow",
    "blueprint",
    "tool-pruning",
    "interactive-sop",
    "blast-radius-guard",
    "cache",
    "coding-agent"
  ],
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0",
    "@sinclair/typebox": "*"
  },
  "author": "Jason",
  "license": "MIT",
  "devDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.80.0",
    "@earendil-works/pi-tui": ">=0.80.0",
    "@sinclair/typebox": "^0.34.52",
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}
